# ==============================================================================
# SYNAPSE STOREFRONT ENVIRONMENT TEMPLATE (NEXT.JS)
# ==============================================================================
# Copy this file to .env.local and fill in the appropriate values:
#   cp apps/storefront/.env.template apps/storefront/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MEDUSA BACKEND & API CONNECTION
# ------------------------------------------------------------------------------
# Publishable API key for the Medusa backend. Required for the storefront to function.
# Retrieve from Admin dashboard: Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Base URL of the storefront (used for canonical/absolute URLs and customer links)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region code (2-letter country code, e.g. vn, dk, us)
NEXT_PUBLIC_DEFAULT_REGION=vn

# ------------------------------------------------------------------------------
# 2. CUSTOMER AUTHENTICATION (GOOGLE ONE-TAP / FEDCM)
# ------------------------------------------------------------------------------
# Enable Google One-Tap authentication for customers
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. PAYMENT & THIRD-PARTY SERVICES (OPTIONAL)
# ------------------------------------------------------------------------------
# Stripe publishable key (optional, only if using Stripe payment provider)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket settings (optional, only for Medusa Cloud / S3 storage)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# ------------------------------------------------------------------------------
# 4. SYSTEM ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
