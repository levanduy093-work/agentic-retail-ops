{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "predeploy": "medusa db:migrate",
    "dev": "medusa develop",
    "agent:bootstrap": "medusa exec ./src/scripts/bootstrap-agent-platform.ts",
    "agent:verify": "medusa exec ./src/scripts/verify-agent-foundation.ts",
    "agent:verify-platform": "medusa exec ./src/scripts/verify-agent-platform.ts",
    "agent:verify-order-exception": "medusa exec ./src/scripts/verify-order-exception-agent.ts",
    "agent:verify-http-rbac": "medusa exec ./src/scripts/verify-agent-http-rbac.ts",
    "agent:verify-order-detector": "medusa exec ./src/scripts/verify-order-exception-detector.ts",
    "agent:prepare-detector-race": "medusa exec ./src/scripts/prepare-order-detector-race.ts",
    "agent:scan-order-detector": "medusa exec ./src/scripts/run-order-detector-scan.ts",
    "agent:verify-detector-race": "medusa exec ./src/scripts/verify-order-detector-race.ts",
    "agent:verify-order-sla-assignment": "medusa exec ./src/scripts/verify-order-sla-assignment.ts",
    "agent:verify-customer-support": "medusa exec ./src/scripts/verify-customer-support-agent.ts",
    "agent:verify-customer-support-staff-flow": "medusa exec ./src/scripts/verify-customer-support-staff-flow.ts",
    "agent:verify-support-simulator": "medusa exec ./src/scripts/verify-support-simulator.ts",
    "agent:assign-support-staff": "medusa exec ./src/scripts/assign-support-staff-role.ts",
    "agent:configure-telegram": "medusa exec ./src/scripts/configure-telegram-channel.ts",
    "agent:verify-telegram": "medusa exec ./src/scripts/verify-telegram-adapter.ts",
    "agent:reindex-knowledge": "medusa exec ./src/scripts/reindex-agent-knowledge.ts",
    "agent:verify-knowledge-hub": "medusa exec ./src/scripts/verify-knowledge-hub.ts",
    "agent:verify-knowledge-connector": "medusa exec ./src/scripts/verify-knowledge-source-connector.ts",
    "agent:verify-rag": "medusa exec ./src/scripts/verify-knowledge-rag.ts",
    "agent:verify-ai-provider-vault": "medusa exec ./src/scripts/verify-ai-provider-vault.ts",
    "agent:check-config": "medusa exec ./src/scripts/check-agent-runtime-configuration.ts",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.5.6",
    "@langchain/qdrant": "^1.0.3",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/caching": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@tanstack/react-query": "5.64.2",
    "google-auth-library": "11.0.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
