STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Enable Redis-backed Event Bus, Workflow Engine and distributed locking in
# staging/production. Local development can leave this false.
REDIS_INFRASTRUCTURE_ENABLED=false
LOCKING_REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Required for Medusa to enforce the `policies` declared on Admin routes.
# The RBAC module alone stores roles and policies but does not activate HTTP checks.
MEDUSA_FF_RBAC=true

# Google Identity Services/FedCM for storefront customers. Register the
# storefront origin in Google Cloud Console under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Model execution is disabled until an approved provider adapter and its secret
# reference are configured. Never expose provider secrets to the Admin client.
AGENT_MODEL_PROVIDER=disabled
AGENT_MODEL_NAME=
AGENT_MODEL_SECRET_REF=

# The internal support chat simulator is enabled automatically outside
# production. Production must opt in explicitly and must never expose it as a
# real customer channel.
AGENT_SUPPORT_SIMULATOR_ENABLED=false

# Telegram bot adapter. Secrets stay in environment variables; the database
# stores only env:... references. TELEGRAM_PUBLIC_BASE_URL must be public HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_BOT_ACCOUNT_REF=primary
# Example: [{"chat_id":"123456789","user_id":"user_..."}]
TELEGRAM_IDENTITIES_JSON=[]

# Optional governed model drafting. Leave disabled until eval/security gates pass.
AGENT_MODEL_PROVIDER=disabled
AGENT_MODEL=
OPENAI_API_KEY=

# Comma-separated HTTPS hosts allowed for remote Markdown/Text knowledge.
# Exact hosts and their subdomains are accepted. Example: raw.githubusercontent.com
KNOWLEDGE_CONNECTOR_ALLOWED_HOSTS=

# Platform-level Google OAuth app. Store owners connect from Admin and never
# enter these values. Use the non-sensitive drive.file scope with Google Picker.
GOOGLE_KNOWLEDGE_OAUTH_CLIENT_ID=
GOOGLE_KNOWLEDGE_OAUTH_CLIENT_SECRET=
GOOGLE_KNOWLEDGE_OAUTH_REDIRECT_URI=http://localhost:9000/admin/agent-operations/knowledge/sources/google-oauth/callback
GOOGLE_KNOWLEDGE_PICKER_API_KEY=
GOOGLE_KNOWLEDGE_CLOUD_PROJECT_NUMBER=
# Recommended in production. When omitted, JWT_SECRET is used as the vault
# master secret so local development can still encrypt connector refresh tokens.
AGENT_CREDENTIAL_ENCRYPTION_KEY=

# The detector scans bounded order pages every five minutes. It only
# acts on orders with agent_payment_due_at or agent_fulfillment_due_at metadata.
ORDER_EXCEPTION_DETECTOR_ENABLED=true
ORDER_EXCEPTION_DETECTOR_SCAN_LIMIT=100
ORDER_EXCEPTION_DETECTOR_MAX_PAGES=5

# Every non-draft order receives deterministic UTC deadlines when it is
# created. Valid deadlines supplied by an OMS are preserved.
ORDER_SLA_ASSIGNMENT_ENABLED=true
ORDER_PAYMENT_SLA_MINUTES=120
ORDER_FULFILLMENT_SLA_MINUTES=2880
