STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Enable Redis-backed Event Bus, Workflow Engine and distributed locking in
# staging/production. Local development can leave this false.
REDIS_INFRASTRUCTURE_ENABLED=true
LOCKING_REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Required for Medusa to enforce the `policies` declared on Admin routes.
# The RBAC module alone stores roles and policies but does not activate HTTP checks.
MEDUSA_FF_RBAC=true

# Google Identity Services/FedCM for storefront customers. Register the
# storefront origin in Google Cloud Console under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Optional for sign-in alone, but required when the same OAuth web client is
# reused by the server-side Google Knowledge connector.
GOOGLE_CLIENT_SECRET=

# AI connections for store owners are configured in Admin > AI connections.
# OpenAI/Gemini API keys, embedding models, reasoning models and the system
# prompt are stored through the Admin workflow; store owners do not edit .env.
# The keys are encrypted in PostgreSQL. Set AGENT_CREDENTIAL_ENCRYPTION_KEY
# below in production so the vault does not need to fall back to JWT_SECRET.

# Telegram bot adapter. Secrets stay in environment variables; the database
# stores only env:... references. TELEGRAM_PUBLIC_BASE_URL must be public HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
# Token of the remotely managed Cloudflare Tunnel used by the cloudflared
# Docker Compose profile. Keep this secret and rotate it if exposed.
CLOUDFLARE_TUNNEL_TOKEN=
TELEGRAM_BOT_ACCOUNT_REF=primary
# Test phase: every private Telegram chat is treated as a customer.
TELEGRAM_ALLOW_UNMAPPED_USERS=true
# Optional allowlist when TELEGRAM_ALLOW_UNMAPPED_USERS=false.
# Every Telegram identity is treated as a CUSTOMER during the current test phase.
# Example: [{"chat_id":"123456789","user_id":"telegram:123456789"}]
TELEGRAM_IDENTITIES_JSON=[]
# Hard backend controls applied before retrieval or any paid model call.
# Keep Redis infrastructure enabled in multi-instance production so these
# per-chat checks are serialized across every backend instance.
TELEGRAM_BURST_LIMIT=6
TELEGRAM_BURST_WINDOW_SECONDS=60
TELEGRAM_DAILY_LIMIT=100
TELEGRAM_GLOBAL_BURST_LIMIT=120
TELEGRAM_GLOBAL_DAILY_LIMIT=5000
TELEGRAM_MAX_MESSAGE_CHARACTERS=2000
TELEGRAM_MAX_UPDATE_AGE_SECONDS=300
TELEGRAM_MAX_OPEN_ESCALATIONS=3
# Emergency denylist. Values are Telegram chat IDs, not usernames.
TELEGRAM_BLOCKED_CHAT_IDS_JSON=[]

# Open-source RAG platform. Qdrant is infrastructure configured by the system
# operator; the store owner selects OpenAI or Gemini embedding from Admin.
# LangChain.js handles embeddings/vector-store access. Canonical documents,
# prompt versions and approval state remain in PostgreSQL.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_knowledge

# Platform-level Google OAuth app. Store owners connect from Admin and never
# enter these values. Leave the dedicated client ID and secret empty to reuse
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above. Set them only when production
# needs a separately rotatable OAuth client for Knowledge.
GOOGLE_KNOWLEDGE_OAUTH_CLIENT_ID=
GOOGLE_KNOWLEDGE_OAUTH_CLIENT_SECRET=
GOOGLE_KNOWLEDGE_OAUTH_REDIRECT_URI=http://localhost:9000/admin/agent-operations/knowledge/sources/google-oauth/callback
# Picker uses a browser-visible API key. Restrict it to the Admin website and
# Google Picker API in Google Cloud Console.
GOOGLE_KNOWLEDGE_PICKER_API_KEY=
# Numeric Google Cloud project number, not the project ID or project name.
GOOGLE_KNOWLEDGE_CLOUD_PROJECT_NUMBER=
# Recommended in production. When omitted, JWT_SECRET is used as the vault
# master secret so local development can still encrypt connector refresh tokens.
AGENT_CREDENTIAL_ENCRYPTION_KEY=

# The detector scans bounded order pages every five minutes. It only
# acts on orders with agent_payment_due_at or agent_fulfillment_due_at metadata.
ORDER_EXCEPTION_DETECTOR_ENABLED=true
ORDER_EXCEPTION_DETECTOR_SCAN_LIMIT=100
ORDER_EXCEPTION_DETECTOR_MAX_PAGES=5

# Every non-draft order receives deterministic UTC deadlines when it is
# created. Valid deadlines supplied by an OMS are preserved.
ORDER_SLA_ASSIGNMENT_ENABLED=true
ORDER_PAYMENT_SLA_MINUTES=120
ORDER_FULFILLMENT_SLA_MINUTES=2880
