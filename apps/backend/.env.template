STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Enable Redis-backed Event Bus, Workflow Engine and distributed locking in
# staging/production. Local development can leave this false.
REDIS_INFRASTRUCTURE_ENABLED=false
LOCKING_REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Required for Medusa to enforce the `policies` declared on Admin routes.
# The RBAC module alone stores roles and policies but does not activate HTTP checks.
MEDUSA_FF_RBAC=true

# Google Identity Services/FedCM for storefront customers. Register the
# storefront origin in Google Cloud Console under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Model execution is disabled until an approved provider adapter and its secret
# reference are configured. Never expose provider secrets to the Admin client.
AGENT_MODEL_PROVIDER=disabled
AGENT_MODEL_NAME=
AGENT_MODEL_SECRET_REF=

# The detector scans bounded non-terminal orders every five minutes. It only
# acts on orders with agent_payment_due_at or agent_fulfillment_due_at metadata.
ORDER_EXCEPTION_DETECTOR_ENABLED=true
ORDER_EXCEPTION_DETECTOR_SCAN_LIMIT=100
