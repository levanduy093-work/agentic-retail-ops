# ==============================================================================
# SYNAPSE BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the appropriate values:
#   cp apps/backend/.env.template apps/backend/.env
#
# NOTE: AI API keys (OpenAI/Gemini/DeepSeek), Chat Channels (Telegram Bot),
# Shipping carriers (GHN), and Payment Gateways (PayOS/SePay) are configured
# directly via the Admin Dashboard GUI and stored encrypted in PostgreSQL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for Store API
STORE_CORS=http://localhost:8000,https://docs.medusajs.com

# Trusted public storefront origin used to build product links in customer chat.
# It must be HTTPS in production and its exact origin must also appear in STORE_CORS.
CUSTOMER_STOREFRONT_BASE_URL=http://localhost:8000

# Comma-separated list of allowed origins for Admin dashboard
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Comma-separated list of allowed origins for Auth routes
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# ------------------------------------------------------------------------------
# 2. DATABASE & SECRETS
# ------------------------------------------------------------------------------
# PostgreSQL connection string (matches docker-compose default: medusa-dtc-starter)
DATABASE_URL=postgres://postgres:@localhost:5432/medusa-dtc-starter

# Secrets for authentication tokens and cookies (use strong random strings in production)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Dedicated secret used to sign Private-mode access sessions. Generate a long,
# random value in production; do not reuse this template value.
DEV_ACCESS_SESSION_SECRET=

# Feature flags. Keep these enabled locally; a deployment can explicitly set
# either one to false when that behavior is intentional.
# Required for Medusa to enforce the `policies` declared on Admin routes.
MEDUSA_FF_RBAC=true
# Enables the Admin Property Labels API exposed by the Medusa dashboard.
MEDUSA_FF_VIEW_CONFIGURATIONS=true

# ------------------------------------------------------------------------------
# 3. REDIS & DISTRIBUTED INFRASTRUCTURE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Enable Redis-backed Event Bus, Workflow Engine and distributed locking in staging/production.
# Local development can leave this true if running Redis via docker-compose.
REDIS_INFRASTRUCTURE_ENABLED=true
LOCKING_REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. GOOGLE AUTHENTICATION & IDENTITY (STOREFRONT & KNOWLEDGE)
# ------------------------------------------------------------------------------
# Google Identity Services/FedCM for storefront customers. Register the
# storefront origin in Google Cloud Console under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Optional for sign-in alone, but required when the same OAuth web client is
# reused by the server-side Google Knowledge connector.
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. AGENT OPERATIONS & KNOWLEDGE HUB (RAG PLATFORM)
# ------------------------------------------------------------------------------
# Dedicated AES-256 encryption key for the Credential Vault (AI keys, Chat channels, etc.)
# If empty, the system falls back to deriving a key from JWT_SECRET.
AGENT_CREDENTIAL_ENCRYPTION_KEY=

# Open-source RAG platform with Qdrant vector database.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_knowledge

# Platform-level Google OAuth app for Knowledge Connector.
# Leave client ID and secret empty to fallback to GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
GOOGLE_KNOWLEDGE_OAUTH_CLIENT_ID=
GOOGLE_KNOWLEDGE_OAUTH_CLIENT_SECRET=
GOOGLE_KNOWLEDGE_OAUTH_REDIRECT_URI=http://localhost:9000/admin/agent-operations/knowledge/sources/google-oauth/callback
GOOGLE_KNOWLEDGE_PICKER_API_KEY=
GOOGLE_KNOWLEDGE_CLOUD_PROJECT_NUMBER=

# ------------------------------------------------------------------------------
# 6. ORDER EXCEPTION DETECTOR & SLA
# ------------------------------------------------------------------------------
ORDER_EXCEPTION_DETECTOR_ENABLED=true
ORDER_EXCEPTION_DETECTOR_SCAN_LIMIT=100
ORDER_EXCEPTION_DETECTOR_MAX_PAGES=5

ORDER_SLA_ASSIGNMENT_ENABLED=true
ORDER_PAYMENT_SLA_MINUTES=120
ORDER_FULFILLMENT_SLA_MINUTES=2880

# ------------------------------------------------------------------------------
# 7. OPTIONAL CLOUDFLARE TUNNEL (LOCAL DEVELOPMENT)
# ------------------------------------------------------------------------------
# Token for remote Cloudflare Tunnel (used with `pnpm run tunnel:up`)
CLOUDFLARE_TUNNEL_TOKEN=
